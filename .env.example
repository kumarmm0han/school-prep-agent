# Environment template (DESIGN.md S2). Copy to .env and adjust; shell env always wins.
# docling-serve is an EXTERNAL, never-replicated dependency (see tracker school-prep-agent-x6h):
# model/service changes are made in the docling-serve project first, then pinned here.
DOCLING_URL=http://localhost:5001
OLLAMA_URL=http://localhost:11434
VLM_MODEL=qwen3-vl:8b
FALLBACK_VLM_MODEL=granite3.2-vision:latest
LLM_MODEL=qwen3.8:27b
EMBED_MODEL=qwen3-embedding
